{
  "name": "the-paradox-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test tests/scenarios.test.mjs",
    "test:integration": "node --experimental-strip-types tests/multiplayer.integration.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.{js,css,html}\" \"tests/**/*.mjs\" \"README.md\" \"docs/**/*.md\" \".github/**/*.yml\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/**/*.{js,css,html}\" \"tests/**/*.mjs\" \"README.md\" \"docs/**/*.md\" \".github/**/*.yml\" \"package.json\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
